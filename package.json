{
  "name": "cryptodesk-ai",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "demo": "pnpm --filter @cryptodesk-ai/federation exec node quick-start-demo.mjs",
    "perf:baseline": "pnpm build --force && pnpm --filter @cryptodesk-ai/market-intelligence exec node performance-baseline.mjs",
    "example:ai": "pnpm --filter @cryptodesk-ai/ai exec node example.mjs",
    "example:morning-meeting": "pnpm --filter @cryptodesk-ai/morning-meeting exec node example.mjs",
    "example:ritual": "pnpm --filter @cryptodesk-ai/ritual-gateway exec node example.mjs",
    "example:runtime-safety": "pnpm --filter @cryptodesk-ai/runtime-safety exec node example.mjs",
    "examples": "pnpm example:ai && pnpm example:morning-meeting && pnpm example:ritual && pnpm example:runtime-safety",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
